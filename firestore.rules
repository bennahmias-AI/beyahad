rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // האם המשתמש המבקש הוא מנהל? נקבע לפי שדה role במסמך שלו עצמו.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if request.auth != null;

      // יצירה — רק את המסמך של עצמך, ואסור לקבוע לעצמך role/blocked.
      allow create: if isAdmin()
        || (request.auth.uid == uid
            && !('role' in request.resource.data)
            && !('blocked' in request.resource.data));

      // עדכון — אדמין רשאי לשנות הכול (כולל role/blocked).
      // משתמש רגיל — רק את המסמך של עצמו, ובלי לגעת ב-role/blocked
      // (מניעת הסלמת הרשאות או שחרור-עצמי מחסימה).
      allow update: if isAdmin()
        || (request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'blocked']));

      // מחיקה — אדמין, או בעל המסמך (מחיקת חשבון עצמית).
      allow delete: if isAdmin() || request.auth.uid == uid;
    }
    match /cafeSessions/{id} {
      allow create: if request.auth != null;
      allow read: if request.auth != null
        && (isAdmin() || request.auth.uid in resource.data.participants);
      allow write: if request.auth != null
        && request.auth.uid in resource.data.participants;
    }
    match /parliamentSessions/{id} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update: if request.auth != null;
    }
    match /cafeQueue/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /communityPosts/{id} {
      allow read: if request.auth != null;
      // יצירה — אדמין יכול ליצור מאושר; משתמש רגיל — רק לא מאושר (ממתין).
      allow create: if isAdmin()
        || (request.auth != null
            && (!('approved' in request.resource.data)
                || request.resource.data.approved == false));
      // עדכון — אדמין רשאי הכול (כולל אישור). כל אחד אחר יכול
      // לעדכן צפיות/לייקים/תוכן — אבל אסור לגעת ב-approved (רק אדמין מאשר).
      allow update: if isAdmin()
        || (request.auth != null
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approved']));
      // מחיקה — אדמין, או מחבר הפוסט.
      allow delete: if isAdmin()
        || (request.auth != null
            && resource.data.authorUid == request.auth.uid);
    }
    match /friendships/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    match /gameRooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.players.size() == 1
        && request.resource.data.players[0].uid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    // ── הזמנות למשחק בין חברים ──
    match /gameInvites/{inviteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    // ── חדרי רמיקוב (2-4 שחקנים) — חדש ──
    // היוצר מתחיל לבד כמארח; שאר השחקנים מצטרפים דרך update.
    match /rummikubRooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.players.size() == 1
        && request.resource.data.players[0].uid == request.auth.uid
        && request.resource.data.hostUid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    // ── חדרי מלך הזירה (דו-קרב טריוויה, 2 שחקנים) — חדש ──
    match /arenaRooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.players.size() == 1
        && request.resource.data.players[0].uid == request.auth.uid
        && request.resource.data.hostUid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    // ── חדרי בינגו (עד 10 שחקנים) — חדש ──
    // המארח (מקריא) יוצר לבד; שאר השחקנים מצטרפים דרך update.
    match /bingoRooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.players.size() == 1
        && request.resource.data.players[0].uid == request.auth.uid
        && request.resource.data.hostUid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    // ── טבלת מובילים יומית של "מי רוצה להיות מיליונר" — חדש ──
    match /millionaireScores/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // ── צ'אט פרטי בין חברים — חדש ──
    // רק שני המשתתפים בשיחה יכולים לקרוא ולכתוב (פרטיות).
    match /directChats/{chatId} {
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow delete: if false;
    }
    // ── שיחות וידאו בין חברים — חדש ──
    // רק המתקשר (fromUid) והמקבל (toUid) יכולים לגשת לשיחה (פרטיות).
    match /videoCalls/{callId} {
      allow read: if request.auth != null
        && (resource == null
            || request.auth.uid == resource.data.fromUid
            || request.auth.uid == resource.data.toUid);
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.fromUid
            || request.auth.uid == resource.data.toUid);
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.fromUid
            || request.auth.uid == resource.data.toUid);
    }
    // ── התראות ניהול/מערכת ──
    // מנהל כותב; המשתמש קורא/מסמן-נקרא רק את ההתראות שמיועדות לו.
    match /notifications/{id} {
      allow read: if request.auth != null
        && (isAdmin() || resource.data.toUid == request.auth.uid);
      allow create: if isAdmin();
      allow update, delete: if request.auth != null
        && (isAdmin() || resource.data.toUid == request.auth.uid);
    }
    // ── יומן פעילות ──
    // כל משתמש רושם אירועים של עצמו; רק מנהל קורא את היומן.
    match /activityLog/{id} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
