rules_version = '2';

// Firebase Storage rules — BEYAHAD
// כללי אבטחה לאחסון קבצים (הקלטות קוליות בצ'אט)
service firebase.storage {
  match /b/{bucket}/o {

    // הודעות קוליות בצ'אט פרטי — voiceMessages/{chatId}/{fileId}.webm
    // קריאה: כל משתמש מחובר (הקישור עצמו ארוך ואקראי).
    // כתיבה: רק משתמש מחובר, קובץ שמע בלבד, עד 10MB.
    match /voiceMessages/{chatId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if false;
    }

    // ברירת מחדל — חוסם כל דבר אחר
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
