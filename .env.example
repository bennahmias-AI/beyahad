# ── Firebase ────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
VITE_FIREBASE_VAPID_KEY=your-vapid-key-from-cloud-messaging-settings

# ── LiveKit ─────────────────────────────────────────────────
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# בפיתוח מקומי: http://localhost:8080/token
# בVercel: /token  (הפונקציה בapi/token.js)
VITE_LIVEKIT_TOKEN_URL=/token

# ── LiveKit Server (ב-Vercel Environment Variables) ─────────
# LIVEKIT_API_KEY=your-key
# LIVEKIT_API_SECRET=your-secret
